{
  "name": "clone-cod",
  "version": "0.1.0",
  "private": true,
  "description": "Clone clean-room de la boucle COD (design system Terre & Encre) — voir replica/architecture.md",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "node scripts/pglite-server.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:init && npm run db:seed",
    "postinstall": "prisma generate && node scripts/patch-prisma-wasm.mjs",
    "db:init": "node scripts/init-db.mjs",
    "postgenerate": "node scripts/patch-prisma-wasm.mjs",
    "start:all": "node scripts/run-all.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.67.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
