# À copier en ".env" AVANT le npm install (le postinstall lit PRISMA_CLIENT_ENGINE_TYPE).
# Dev local: Postgres émulé par PGlite (scripts/pglite-server.mjs), vrai schéma Postgres.
# En local PGlite est mono-utilisateur (superuser) : le RLS y est contourné, l'isolation
# est alors appliquée au niveau app (store_id) et prouvée par tests/isolation/run.mjs.
# En PROD (Neon): utiliser un rôle NON superuser dédié (créé avec les grants par
# scripts/enable-rls.mjs) — c'est lui qui subit le RLS (policies fail-closed).
# Les scripts d'admin (init-db/seed/enable-rls) utilisent ADMIN_DATABASE_URL (superuser local).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
# Prod: Neon, région eu-central-1 (Francfort)
# DATABASE_URL="postgresql://...@eu-central-1.aws.neon.tech/neondb"
AUTH_SECRET="change-me-dev-only"
# Hôte racine du déploiement: app.<domaine> = dashboard, <slug>.<domaine> = boutiques
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
# Client Prisma en compilateur de requêtes WASM embarqué (aucun binaire Rust à télécharger).
# Indispensable: sans ça, le client généré exige libquery_engine (.so.node) au runtime.
PRISMA_CLIENT_ENGINE_TYPE="client"
# Cookie de session Secure uniquement en prod HTTPS (laisser vide en local http)
# COOKIE_SECURE="true"
